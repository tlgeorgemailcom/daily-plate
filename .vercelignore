# Quarantined / historical
_archived/

# Python pipeline (runs locally, never on Vercel)
# IMPORTANT: recipes_v3/output/builds/*.json must NOT be excluded — they are
# bundled at Vite build time via import.meta.glob in /api/recipes/v3-build/.
# We exclude the contents of recipes_v3/ directory-by-directory (gitignore
# negation cannot re-include files under an ignored directory).
recipes_v3/data/
recipes_v3/lib/
recipes_v3/tools/
recipes_v3/tests/
recipes_v3/baselines/
recipes_v3/__pycache__/
recipes_v3/output/upload_log/
recipes_v3/*.md
recipes_v3/*.py
recipes_v3/PHASE_*
recipes_v3/config.py
__pycache__/
*.pyc

# Documentation
docs/
*.md
!README.md

# Database migrations (manual SQL, run out-of-band)
migrations/
*.sql
schema.sql

# Local SQLite / WAL artifacts
*.db
*.sqlite
migration_006*

# Source spreadsheets and generator-input CSVs (consumed only by local scripts/dev/)
*.numbers
food-portions-complete.csv
food-groups-with-ndb-no.csv
food-groups-with-ndb.csv
food-groups-edit.csv

# Local dev scripts not invoked by Vercel build
scripts/dev/

# Tests
tests/
test/
*.test.ts
*.spec.ts

# Editor / OS junk
.DS_Store
.vscode/
.idea/
